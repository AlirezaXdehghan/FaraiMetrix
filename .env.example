# Farai Metrix service. Copy to .env (never committed) or set in the container.
PORT=4000
METRIX_DB=.metrix-data/metrix.sqlite
METRIX_TENANTS=tenants.json

# Referenced from tenants.json as "env:NAME". Each at least 24 characters:
#   openssl rand -hex 24
METRIX_BRUSATO_API_KEY=
METRIX_BRUSATO_CONSOLE_PASSWORD=
# The same value as CALLDASH_METRIX_SECRET on the CallDash side.
METRIX_BRUSATO_CALLDASH_SECRET=
